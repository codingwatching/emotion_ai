# Aura configuration. Copy to .env and select an installed conversation model.
# Shell environment values override this file. Never commit credentials.

# Conversation provider: ollama, gemini, or openrouter.
AURA_DEFAULT_PROVIDER=ollama
AURA_MODEL=llama3.1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL / OPENROUTER_MODEL override AURA_MODEL if explicitly set.
AURA_MAX_OUTPUT_TOKENS=8192
AURA_HISTORY_MAX_CHARS=24000
AURA_PROVIDER_REQUEST_TIMEOUT_SECONDS=120
AURA_PROVIDER_READ_TIMEOUT_SECONDS=120
MAX_FUNCTION_CALL_ROUNDS=3

# Optional cloud credentials, used only for the selected cloud provider.
# Gemini: set AURA_DEFAULT_PROVIDER=gemini and AURA_MODEL=gemini-2.5-flash.
# GEMINI_API_KEY=<set-in-private-environment>
THINKING_BUDGET=-1
# OpenRouter: set AURA_DEFAULT_PROVIDER=openrouter and choose AURA_MODEL.
# OPENROUTER_API_KEY=<set-in-private-environment>
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local web application.
AURA_HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
AURA_RELOAD=false
DEBUG=false
LOG_LEVEL=INFO

# SQLite is authoritative; Chroma is its rebuildable search index.
# The default ledger is this repository's aura_data_v2 directory.
# AURA_LEDGER_DIRECTORY accepts an absolute path to a separate ledger directory.
AURA_CLEAN_INSTALL=true
AURA_DATA_DIRECTORY=./aura_data
CHROMA_PERSIST_DIRECTORY=./aura_chroma_db
# Preserve existing MiniLM indexes by default. To select installed Ollama
# embeddings, change provider to ollama and model to embeddinggemma:latest.
AURA_EMBEDDING_PROVIDER=sentence_transformers
AURA_EMBEDDING_MODEL=all-MiniLM-L6-v2
# AURA_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Optional copy-only archives; not required for normal recall.
AURA_MEMVID_ENABLED=false
MEMVID_TELEMETRY=0
MEMVID_EMBEDDING_PROVIDER=ollama
MEMVID_EMBEDDING_MODEL=embeddinggemma:latest
AURA_MCP_ENABLED=false

# Background index maintenance at startup, after committed turns and periodically.
# Explicit model tasks share AURA_DEFAULT_PROVIDER / AURA_MODEL with chat.
# AURA_AUTONOMIC_MODEL and AFC_* are obsolete and have no effect.
AUTONOMIC_ENABLED=false
AUTONOMIC_MAINTENANCE_INTERVAL_SECONDS=300
AUTONOMIC_MAX_CONCURRENT_TASKS=1
AUTONOMIC_QUEUE_MAX_SIZE=32
AUTONOMIC_QUEUE_PRIORITY_ENABLED=true
AUTONOMIC_TASK_THRESHOLD=medium
AURA_AUTONOMIC_MAX_OUTPUT_TOKENS=2048
AUTONOMIC_TIMEOUT_SECONDS=120
AUTONOMIC_RATE_LIMIT_RPM=10
AUTONOMIC_RATE_LIMIT_RPD=500
# These rate limits apply to background model tasks, not to maintenance or chat.
